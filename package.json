{
  "name": "copilot-sdk-provider",
  "version": "0.1.0",
  "description": "Vercel AI SDK provider for GitHub Copilot SDK — use Copilot as a LanguageModelV3",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@ai-sdk/provider-utils": "^4.0.1"
  },
  "peerDependencies": {
    "@github/copilot-sdk": ">=0.1.8",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@github/copilot-sdk": "^0.1.0",
    "@types/node": "^25.6.0",
    "ai": "^6.0.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai",
    "provider",
    "copilot",
    "github",
    "github-copilot",
    "language-model",
    "llm",
    "agent",
    "agentic"
  ],
  "author": "rubenhig",
  "homepage": "https://github.com/rubenhig/copilot-sdk-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenhig/copilot-sdk-provider.git"
  },
  "bugs": {
    "url": "https://github.com/rubenhig/copilot-sdk-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
